<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 784 804" width="784" height="804" role="img" aria-label="Nikan School logo" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0a2478"/>
      <stop offset="0.55" stop-color="#0d2c8a"/>
      <stop offset="1" stop-color="#2038b4"/>
    </linearGradient>
    <linearGradient id="goldTop" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e9bf4a"/>
      <stop offset="0.45" stop-color="#f7d777"/>
      <stop offset="1" stop-color="#e2b23a"/>
    </linearGradient>
    <linearGradient id="goldBody" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d9a92f"/>
      <stop offset="1" stop-color="#ecc258"/>
    </linearGradient>
    <linearGradient id="goldTassel" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#d9a92f"/>
      <stop offset="0.5" stop-color="#f1cc66"/>
      <stop offset="1" stop-color="#d09c26"/>
    </linearGradient>
    <linearGradient id="nStroke" gradientUnits="userSpaceOnUse" x1="0" y1="370" x2="0" y2="585">
      <stop offset="0" stop-color="#8f7f6b" stop-opacity="1"/>
      <stop offset="0.6" stop-color="#8f7f6b" stop-opacity="0.95"/>
      <stop offset="1" stop-color="#8f7f6b" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="page" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff"/>
      <stop offset="1" stop-color="#efe6d2"/>
    </linearGradient>
    <linearGradient id="pageShade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fbf6ea"/>
      <stop offset="1" stop-color="#e3d6b8"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#000820" flood-opacity="0.35"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="784" height="804" rx="40" fill="url(#bg)"/>

  <!-- Graduation cap -->
  <g filter="url(#shadow)">
    <!-- cap body -->
    <path d="M258 215 L258 282 Q392 352 528 284 L528 215 Z" fill="url(#goldBody)"/>
    <!-- board thickness -->
    <path d="M165 166 L395 280 L620 168 L620 176 L395 290 L165 174 Z" fill="#c8932a"/>
    <!-- board top -->
    <path d="M165 165 L392 62 L620 166 L395 278 Z" fill="url(#goldTop)"/>
    <!-- string -->
    <rect x="184" y="180" width="6" height="84" fill="#e2b23a"/>
    <!-- ball -->
    <circle cx="190" cy="273" r="13" fill="#e8bc47"/>
    <!-- tassel -->
    <path d="M181 287 L199 287 L211 365 Q211 374 202 374 L181 374 Q172 374 172 365 Z" fill="url(#goldTassel)"/>
  </g>

  <!-- N monogram (outline) -->
  <g fill="none" stroke="url(#nStroke)" stroke-width="5" stroke-linejoin="miter" stroke-linecap="butt">
    <path d="M298 585 V385 L487 560 V370 L450 408"/>
    <path d="M335 585 V420 L450 527 V408"/>
  </g>

  <!-- Open book -->
  <g filter="url(#shadow)">
    <!-- left half -->
    <g>
      <path d="M155 722 Q290 700 392 750 L392 762 Q290 716 158 734 Z" fill="#c8932a"/>
      <path d="M163 694 L215 628 Q320 645 392 712 L392 750 Q290 702 163 710 Z" fill="url(#pageShade)"/>
      <path d="M185 668 L232 604 Q330 620 392 690 L392 740 Q300 680 185 690 Z" fill="#f5eedd"/>
      <path d="M205 640 L248 588 Q335 600 392 672 L392 735 Q310 668 205 656 Z" fill="url(#page)"/>
    </g>
    <!-- right half (mirrored) -->
    <g transform="translate(784,0) scale(-1,1)">
      <path d="M155 722 Q290 700 392 750 L392 762 Q290 716 158 734 Z" fill="#c8932a"/>
      <path d="M163 694 L215 628 Q320 645 392 712 L392 750 Q290 702 163 710 Z" fill="url(#pageShade)"/>
      <path d="M185 668 L232 604 Q330 620 392 690 L392 740 Q300 680 185 690 Z" fill="#f5eedd"/>
      <path d="M205 640 L248 588 Q335 600 392 672 L392 735 Q310 668 205 656 Z" fill="url(#page)"/>
    </g>
    <!-- spine shadow -->
    <path d="M392 690 L392 752" stroke="#d9cdb0" stroke-width="2"/>
  </g>
</svg>
